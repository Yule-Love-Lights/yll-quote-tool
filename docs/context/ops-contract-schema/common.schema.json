{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.yulelovelights.com/schemas/operations-hub/common.schema.json",
  "title": "Yule Love Lights Operations Hub shared contract schemas",
  "schema_version": "1.0.0-draft",
  "contract_version": "1.4.0-draft",
  "$defs": {
    "ContractVersion": {
      "type": "string",
      "const": "1.4.0-draft"
    },
    "SchemaVersion": {
      "type": "string",
      "const": "1.0.0-draft"
    },
    "ClientVersion": {
      "type": "string",
      "minLength": 1
    },
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "NullableUuid": {
      "oneOf": [
        {
          "$ref": "#/$defs/Uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "Source": {
      "type": "string",
      "enum": [
        "hub_pwa",
        "telegram",
        "office",
        "admin",
        "system"
      ]
    },
    "CommandStatus": {
      "type": "string",
      "enum": [
        "accepted",
        "accepted_with_review",
        "pending",
        "rejected",
        "superseded"
      ]
    },
    "ReviewFlag": {
      "type": "string",
      "enum": [
        "none",
        "needs_review",
        "quarantined"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "unauthorized",
        "forbidden",
        "not_found",
        "conflict_stale_version",
        "conflict_idempotency",
        "validation_failed",
        "gate_locked",
        "kill_switched",
        "rate_limited",
        "internal",
        "contract_version_unsupported",
        "schema_version_unsupported",
        "entity_version_conflict",
        "identity_not_linked",
        "membership_stale",
        "active_department_required",
        "clock_required",
        "offline_packet_expired",
        "offline_packet_scope_denied",
        "effective_time_review_required",
        "placement_ack_pending",
        "inventory_reconciliation_required",
        "pay_period_locked"
      ]
    },
    "NullableErrorCode": {
      "oneOf": [
        {
          "$ref": "#/$defs/ErrorCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "GpsEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude",
        "accuracy_meters",
        "captured_at",
        "source"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "accuracy_meters": {
          "type": "number",
          "minimum": 0
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CommandRequest": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "command_id",
        "idempotency_key",
        "semantic_operation",
        "actor_employee_id",
        "impersonating_actor_id",
        "source",
        "contract_version",
        "schema_version",
        "client_version",
        "expected_entity_version",
        "device_occurred_at",
        "device_timezone",
        "client_sequence",
        "effective_at_requested",
        "offline_packet_id",
        "active_department_id",
        "membership_version",
        "gps_evidence",
        "reason",
        "evidence_refs",
        "correlation_id"
      ],
      "properties": {
        "command_id": {
          "$ref": "#/$defs/Uuid"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "semantic_operation": {
          "type": "string",
          "minLength": 1
        },
        "actor_employee_id": {
          "$ref": "#/$defs/Uuid"
        },
        "impersonating_actor_id": {
          "$ref": "#/$defs/NullableUuid"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "contract_version": {
          "$ref": "#/$defs/ContractVersion"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "client_version": {
          "$ref": "#/$defs/ClientVersion"
        },
        "expected_entity_version": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "device_occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "device_timezone": {
          "type": "string",
          "minLength": 1
        },
        "client_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "effective_at_requested": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "offline_packet_id": {
          "$ref": "#/$defs/NullableUuid"
        },
        "active_department_id": {
          "$ref": "#/$defs/NullableUuid"
        },
        "membership_version": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "gps_evidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/GpsEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "correlation_id": {
          "$ref": "#/$defs/Uuid"
        }
      }
    },
    "CommandResponse": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "command_id",
        "canonical_operation_id",
        "command_status",
        "received_at",
        "effective_at",
        "entity_version",
        "review_flag",
        "error_code",
        "duplicate_of_command_id",
        "contract_version",
        "schema_version",
        "client_version",
        "correlation_id"
      ],
      "properties": {
        "command_id": {
          "$ref": "#/$defs/Uuid"
        },
        "canonical_operation_id": {
          "$ref": "#/$defs/Uuid"
        },
        "command_status": {
          "$ref": "#/$defs/CommandStatus"
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "effective_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "entity_version": {
          "type": "integer",
          "minimum": 0
        },
        "review_flag": {
          "$ref": "#/$defs/ReviewFlag"
        },
        "error_code": {
          "$ref": "#/$defs/NullableErrorCode"
        },
        "duplicate_of_command_id": {
          "$ref": "#/$defs/NullableUuid"
        },
        "contract_version": {
          "$ref": "#/$defs/ContractVersion"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "client_version": {
          "$ref": "#/$defs/ClientVersion"
        },
        "correlation_id": {
          "$ref": "#/$defs/Uuid"
        }
      }
    },
    "EventEnvelope": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "event_id",
        "event_type",
        "aggregate_id",
        "entity_version",
        "occurred_at",
        "effective_at",
        "accepted_at",
        "actor_employee_id",
        "source",
        "contract_version",
        "schema_version",
        "client_version",
        "correlation_id",
        "causation_id",
        "idempotency_key"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/Uuid"
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "aggregate_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_version": {
          "type": "integer",
          "minimum": 0
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        },
        "actor_employee_id": {
          "$ref": "#/$defs/NullableUuid"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "contract_version": {
          "$ref": "#/$defs/ContractVersion"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "client_version": {
          "$ref": "#/$defs/ClientVersion"
        },
        "correlation_id": {
          "$ref": "#/$defs/Uuid"
        },
        "causation_id": {
          "$ref": "#/$defs/NullableUuid"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "system"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {},
          "else": {
            "properties": {
              "actor_employee_id": {
                "$ref": "#/$defs/Uuid"
              }
            }
          }
        }
      ]
    },
    "MachineKeyId": {
      "type": "string",
      "minLength": 1
    },
    "UnixTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{10,}$"
    },
    "MachineNonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,}$"
    },
    "MachineSignature": {
      "type": "string",
      "pattern": "^v1=[0-9a-f]{64}$"
    }
  }
}
