          "error_code",
          "duplicate_of_command_id",
          "contract_version",
          "schema_version",
          "client_version",
          "correlation_id"
        ],
        "properties": {
          "command_id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "canonical_operation_id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "command_status": {
            "$ref": "#/components/schemas/CommandStatus"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "effective_at": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "entity_version": {
            "type": "integer",
            "minimum": 0
          },
          "review_flag": {
            "$ref": "#/components/schemas/ReviewFlag"
          },
          "error_code": {
            "$ref": "#/components/schemas/NullableErrorCode"
          },
          "duplicate_of_command_id": {
            "$ref": "#/components/schemas/NullableUuid"
          },
          "contract_version": {
            "$ref": "#/components/schemas/ContractVersion"
          },
          "schema_version": {
            "$ref": "#/components/schemas/SchemaVersion"
          },
          "client_version": {
            "$ref": "#/components/schemas/ClientVersion"
          },
          "correlation_id": {
            "$ref": "#/components/schemas/Uuid"
          }
        }
      },
      "EventEnvelope": {
        "type": "object",
        "required": [
          "event_id",
          "event_type",
          "aggregate_id",
          "entity_version",
          "occurred_at",
          "effective_at",
          "accepted_at",
          "actor_employee_id",
          "source",
          "contract_version",
          "schema_version",
          "client_version",
          "correlation_id",
          "causation_id",
          "idempotency_key"
        ],
        "properties": {
          "event_id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "event_type": {
            "type": "string",
            "minLength": 1
          },
          "aggregate_id": {
            "type": "string",
            "minLength": 1
          },
          "entity_version": {
            "type": "integer",
            "minimum": 0
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "effective_at": {
            "type": "string",
            "format": "date-time"
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time"
          },
          "actor_employee_id": {
            "$ref": "#/components/schemas/NullableUuid"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "contract_version": {
            "$ref": "#/components/schemas/ContractVersion"
          },
          "schema_version": {
            "$ref": "#/components/schemas/SchemaVersion"
          },
          "client_version": {
            "$ref": "#/components/schemas/ClientVersion"
          },
          "correlation_id": {
            "$ref": "#/components/schemas/Uuid"
          },
          "causation_id": {
            "$ref": "#/components/schemas/NullableUuid"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "const": "system"
                }
              },
              "required": [
                "source"
              ]
            },
            "then": {},
            "else": {
              "properties": {
                "actor_employee_id": {
                  "$ref": "#/components/schemas/Uuid"
                }
              }
            }
          }
        ]
      },
      "CanonicalUuid": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "ResolvedContactRef": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CanonicalUuid"
          }
        ],
        "description": "Canonical lowercase Quote Tool-owned UUID; never a phone number or email address."
      },
      "ContactIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resolution",
          "contact_ref"
        ],
        "properties": {
          "resolution": {
            "type": "string",
            "enum": [
              "resolved",
              "manual_only"
            ]
          },
          "contact_ref": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ResolvedContactRef"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "resolution": {
                  "const": "resolved"
                }
              },
              "required": [
                "resolution"
              ]
            },
            "then": {
              "properties": {
                "contact_ref": {
                  "$ref": "#/components/schemas/ResolvedContactRef"
                }
              }
            },
            "else": {
              "properties": {
                "contact_ref": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "PerformerIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "employee_id",
          "system_principal"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "employee",
              "system"
            ]
          },
          "employee_id": {
            "$ref": "#/components/schemas/NullableUuid"
          },
          "system_principal": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "employee"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "employee_id": {
                  "$ref": "#/components/schemas/Uuid"
                },
                "system_principal": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "employee_id": {
                  "type": "null"
                },
                "system_principal": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "QuoteSentEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EventEnvelope"
          },
          {
            "type": "object",
            "required": [
              "quote_id",
              "quote_number",
              "contact_identity",
              "sending_rep_employee_id",
              "sent_at",
              "total_cents"
            ],
            "properties": {
              "event_type": {
                "const": "QuoteSent"
              },
              "aggregate_id": {
                "$ref": "#/components/schemas/CanonicalUuid"
              },
              "entity_version": {
                "type": "integer",
                "minimum": 1
              },
              "quote_id": {
                "$ref": "#/components/schemas/CanonicalUuid"
              },
              "quote_number": {
                "type": "string",
                "minLength": 1
              },
              "contact_identity": {
                "$ref": "#/components/schemas/ContactIdentity"
              },
              "sending_rep_employee_id": {
                "$ref": "#/components/schemas/Uuid"
              },
              "sent_at": {
                "type": "string",
                "format": "date-time"
              },
              "total_cents": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        ],
        "unevaluatedProperties": false
      },
      "OutboundMessageChannel": {
        "type": "string",
        "enum": [
          "sms",
          "email"
        ]
      },
      "OutboundMessageSentEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EventEnvelope"
          },
          {
            "type": "object",
            "required": [
              "outbound_delivery_id",
              "contact_identity",
              "performed_by",
              "channel",
              "sent_at",
              "has_media",
              "has_portal_link"
            ],
            "properties": {
              "event_type": {
                "const": "OutboundMessageSent"
              },
              "aggregate_id": {
                "$ref": "#/components/schemas/CanonicalUuid"
              },
              "entity_version": {
                "type": "integer",
                "minimum": 1
              },
              "outbound_delivery_id": {
                "$ref": "#/components/schemas/CanonicalUuid"
              },
              "contact_identity": {
                "$ref": "#/components/schemas/ContactIdentity"
              },
              "performed_by": {
                "$ref": "#/components/schemas/PerformerIdentity"
              },
              "channel": {
                "$ref": "#/components/schemas/OutboundMessageChannel"
              },
              "sent_at": {
                "type": "string",
                "format": "date-time"
              },
              "has_media": {
                "type": "boolean"
              },
              "has_portal_link": {
                "type": "boolean"
              }
            }
          }
        ],
        "unevaluatedProperties": false
      },
      "CallDirection": {
        "type": "string",
        "enum": [
          "inbound",
          "outbound"
        ]
      },
      "CallAttemptedEvent": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EventEnvelope"
          },
          {
            "type": "object",
            "required": [
              "call_attempt_id",
              "contact_identity",
              "performed_by",
              "direction",
              "duration_seconds",
              "connected",
              "attempted_at"
            ],
            "properties": {
              "event_type": {
                "const": "CallAttempted"
              },
              "aggregate_id": {
                "$ref": "#/components/schemas/CanonicalUuid"
              },
              "entity_version": {
                "type": "integer",
                "minimum": 1
              },
              "call_attempt_id": {
                "$ref": "#/components/schemas/CanonicalUuid"
              },
              "contact_identity": {
                "$ref": "#/components/schemas/ContactIdentity"
              },
              "performed_by": {
                "$ref": "#/components/schemas/PerformerIdentity"
              },
              "direction": {
                "$ref": "#/components/schemas/CallDirection"
              },
              "duration_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "connected": {
                "type": "boolean"
              },
              "attempted_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ],
        "unevaluatedProperties": false
      },
      "CommitmentEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/QuoteSentEvent"
          },
          {
            "$ref": "#/components/schemas/OutboundMessageSentEvent"
          },
          {
            "$ref": "#/components/schemas/CallAttemptedEvent"
          }
        ],
        "discriminator": {
          "propertyName": "event_type",
          "mapping": {
            "QuoteSent": "#/components/schemas/QuoteSentEvent",
            "OutboundMessageSent": "#/components/schemas/OutboundMessageSentEvent",
            "CallAttempted": "#/components/schemas/CallAttemptedEvent"
          }
        }
      },
      "CommitmentEventsPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "events",
          "next_cursor",
          "has_more",
          "contract_version",
          "schema_version",
          "client_version",
          "correlation_id"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommitmentEvent"
            }
          },
          "next_cursor": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "has_more": {
            "type": "boolean"
          },
          "contract_version": {
            "$ref": "#/components/schemas/ContractVersion"
          },
          "schema_version": {
            "$ref": "#/components/schemas/SchemaVersion"
          },
          "client_version": {
            "$ref": "#/components/schemas/ClientVersion"
          },
          "correlation_id": {
            "$ref": "#/components/schemas/Uuid"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "has_more": {
                  "const": true
                }
              },
              "required": [
                "has_more"
              ]
            },
            "then": {
              "properties": {
                "next_cursor": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "MachineKeyId": {
        "type": "string",
        "minLength": 1
      },
      "UnixTimestamp": {
        "type": "string",
        "pattern": "^[0-9]{10,}$"
      },
      "MachineNonce": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{22,}$"
      },
      "MachineSignature": {
        "type": "string",
        "pattern": "^v1=[0-9a-f]{64}$"
      }
    }
  }
}
