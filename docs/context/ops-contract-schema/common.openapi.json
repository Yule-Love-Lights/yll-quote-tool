  "info": {
    "title": "Yule Love Lights Operations Hub shared contract components",
    "version": "1.0.0-draft"
  },
  "paths": {
    "/api/ops/v1/commitment-events": {
      "get": {
        "operationId": "listCommitmentEvents",
        "summary": "Pull Quote Tool commitment-verification events",
        "description": "The commitment store calls Quote Tool with the consumer-to-QT machine credential. The route is unavailable while COMMITMENT_EVENTS_ENABLED is off.",
        "security": [
          {
            "YllHmac": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/YllKeyId"
          },
          {
            "$ref": "#/components/parameters/YllTimestamp"
          },
          {
            "$ref": "#/components/parameters/YllNonce"
          },
          {
            "$ref": "#/components/parameters/YllSignature"
          },
          {
            "$ref": "#/components/parameters/YllContractVersion"
          },
          {
            "$ref": "#/components/parameters/YllSchemaVersion"
          },
          {
            "$ref": "#/components/parameters/YllClientVersion"
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A cursor-ordered page of commitment-verification events.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommitmentEventsPage"
                }
              }
            }
          },
          "401": {
            "description": "Generic machine-authentication failure."
          },
          "409": {
            "description": "The signed caller contract or schema version is incompatible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionUnsupportedReadErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "The supplied cursor expired and requires audited admin reconciliation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CursorExpiredReadErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "The independent commitment-events kill switch is off.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KillSwitchedReadErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
