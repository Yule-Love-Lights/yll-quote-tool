# Copy to .env.local and fill in real values. .env.local is gitignored.

# === Anthropic Claude (vision + quote analysis) ===
ANTHROPIC_API_KEY=sk-ant-...

# === Google Maps / Street View / Satellite (address analysis) ===
GOOGLE_MAPS_API_KEY=AIza...
# OPTIONAL — live Google reviews on the customer portal (#22). The Place ID of
# the Yule Love Lights Google Business Profile. When set (and the Places API is
# enabled on the key above), the portal shows the real star rating + featured
# 5-star reviews instead of the built-in placeholders; unset → placeholders.
# Find it at https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=ChIJ...

# === Voyage AI (image embeddings — #8 Stage B similarity retrieval) ===
# OPTIONAL. When set, the analyzer retrieves the most VISUALLY SIMILAR past
# training examples (voyage-multimodal-3.5, 1024-dim, stored in pgvector) as
# few-shot context instead of just the most recent. Unset → graceful fallback
# to recency (analyze still works). Free tier (200M tokens + 150B pixels) far
# exceeds this app's volume. Get a key at https://dash.voyageai.com.
VOYAGE_API_KEY=pa-...

# === Supabase (quotes, corrections, training, designs) ===
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Service-role key bypasses RLS. Used by server-side reads/writes (portal
# loader, designs, admin routes). Server-side ONLY — never expose to the
# browser. Get it from Supabase dashboard → Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Shared secret required for admin mutations (approve/reject/delete).
# Pick a long random string. Admin UI prompts for it once per session.
ADMIN_SECRET=change-me-to-something-long-and-random

# === HighLevel / GoHighLevel (CRM) ===
# Private Integration token scoped to the Yule Love Lights location. Create
# at https://app.gohighlevel.com → Settings → Private Integrations → New.
# The quote tool uses this for: contact search, contact fetch, opportunity
# create/update. If unset, the admin UI falls back to manual customer entry.
HIGHLEVEL_API_KEY=pit-...
# Location ID — found in Settings → Company → Business Info, or at the end
# of the URL when viewing a sub-account.
HIGHLEVEL_LOCATION_ID=...
# Pipeline + stage IDs for the Holiday Lights sales pipeline. Discover once
# by calling listPipelines() from src/lib/integrations/highlevel.ts.
# (Note: a one-off dev script for this is referenced in code comments but is
# NOT committed to the repo — call listPipelines() from a scratch route/script.)
HIGHLEVEL_PIPELINE_ID=...
HIGHLEVEL_STAGE_QUOTE_CREATED=...      # stage when a new quote is built in this tool
HIGHLEVEL_STAGE_QUOTE_SENT=...         # stage when quote is sent to customer for sign/pay
HIGHLEVEL_STAGE_QUOTE_INTERESTED=...   # stage when the customer APPROVES on the portal (approve route)
HIGHLEVEL_STAGE_QUOTE_SIGNED=...       # stage when home.works reports signature (inbound webhook)
# === Quote-send notifications (#37) ===
# When staff hit "Send Quote," the portal link is delivered to the customer via
# GHL (SMS + Email) so it shows in the Conversations tab.
# SMS sending number in E.164 (the business line). Omit to use the GHL location default.
HIGHLEVEL_SMS_FROM_NUMBER=+16315170186
# From / reply-to address for the quote-ready email.
HIGHLEVEL_EMAIL_FROM=sales@yulelovelights.com
# GHL contact id that receives the internal "go collect the 50% deposit" email
# when a customer approves (pre-Valor placeholder flow). This is the sales@
# GHL contact. If unset, the internal notification is skipped (customer SMS +
# email still send). Must be set in Vercel too for prod parity.
HIGHLEVEL_INTERNAL_CONTACT_ID=...
# Public base URL used to build the customer-facing portal link in those
# messages. Falls back to the request origin if unset — set to the canonical
# domain on Vercel so links never point at a preview/localhost URL.
PORTAL_BASE_URL=https://quote.yulelovelights.com

# === Customer portal — surface copy + scarcity ===
# These are public (NEXT_PUBLIC_*) so they ship in the client bundle. They
# do not contain secrets — just human-readable copy that needs to be the
# same on the server-rendered HTML and any client component reading it.
#
# Naldo's name as it appears across the portal (signature line, "Text X
# directly", walkthrough video eyebrow, approved page, etc.). Default: Naldo.
NEXT_PUBLIC_PORTAL_LEADER_NAME=Naldo
# Direct phone number for the "Text Naldo" CTA (tap-to-call). Use the
# format you want displayed — e.g. "(631) 555-0148". The tel: link strips
# non-digits automatically. If unset, falls back to the mock placeholder.
NEXT_PUBLIC_PORTAL_PHONE=(631) 517-0186
# Honest scarcity numbers shown in the urgency banner. Update these weekly
# (or set NEXT_PUBLIC_PORTAL_WEEKLY_BOOKINGS to '0' to soften the message).
# Both fall back to safe defaults if unset.
NEXT_PUBLIC_PORTAL_WEEKLY_BOOKINGS=8
NEXT_PUBLIC_PORTAL_BOOKED_THROUGH_DATE=early November
# Global walkthrough video shown on EVERY customer portal — the 11-char
# YouTube video ID only (not the full URL). e.g. for https://youtu.be/IT_ijiewMBg
# the value is IT_ijiewMBg. A per-quote video attached in the admin UI
# (/admin/quotes/[id]/video) overrides this global default for that quote.
NEXT_PUBLIC_PORTAL_WALKTHROUGH_VIDEO_ID=IT_ijiewMBg

# === Home.works (field service) — via Zapier ===
# home.works doesn't expose a direct API for our use case, so we route
# quote-send events through a Zapier Catch Hook. Zap setup:
#   1. Create a new Zap with trigger "Webhooks by Zapier → Catch Hook"
#   2. Copy the Catch Hook URL here
#   3. Add an action: home.works "Create Estimate" — map fields from the
#      payload (see HomeworksPayload type in src/lib/integrations/types.ts)
#   4. Turn the Zap on
# If unset, the "Send to Home.works" button is hidden in the admin UI.
HOMEWORKS_ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/.../...

# Inbound signature webhook (home.works → Zapier → us). Shared secret
# the Zap passes in the `x-homeworks-secret` header. Anyone with this
# value can advance any quote to the "signed" stage, so treat it like
# a credential — generate with:  openssl rand -hex 32
# Configure the matching Zap as:
#   1. Trigger:  home.works "Contract Signed" event (or whatever they
#                expose — Naldo to confirm the trigger name)
#   2. Action:   Webhooks by Zapier → POST →
#                URL  = https://yulelovelights.com/api/integrations/homeworks/signed
#                Body = JSON  { "quoteId": "{{external_reference}}",
#                               "signedAt": "{{signed_at}}",
#                               "homeworksContractId": "{{contract_id}}" }
#                Headers: x-homeworks-secret = (this value)
# If unset, the receiving endpoint returns 503 — useful guard against
# accepting webhooks before the Zap is wired up correctly.
HOMEWORKS_SIGNED_SECRET=...

# === Inventory supplier ordering (#82 Phase 3 auto-ordering) ===
# The GHL contact representing the supplier (Thunder Lighting's ordering email).
# /inventory/orders generates a purchase order (shortfall across booked jobs vs
# on-hand) and, when staff click "Send to supplier", emails it to this contact
# via GHL. Unset → the send button returns 503 (the PO still previews). Make a
# GHL contact for Thunder's order inbox and put its contact id here.
THUNDER_ORDER_CONTACT_ID=...
# OPTIONAL unattended auto-send: when 'true', a weekly Vercel Cron
# (/api/inventory/purchase-order/auto-send) emails the PO to the supplier with NO
# human click — dedup'd so it never re-sends an unchanged order. OFF by default
# (the human-gated /inventory/orders "Send" is the safer default). Also requires
# CRON_SECRET (shared with the low-stock alarm cron). ⚠️ No on-order tracking, so
# keep the weekly cadence; it can re-order if the shortfall changes before stock
# arrives. Leave 'false' unless you're confident.
PO_AUTO_SEND_ENABLED=false
# Shared cron auth (Vercel attaches `Authorization: Bearer ${CRON_SECRET}` to cron
# requests; the cron endpoints require it). openssl rand -hex 32. Set in Vercel too.
CRON_SECRET=...

# === Inventory WhatsApp bot (#82 Phase 3) — DORMANT until enabled ===
# Staff text the WhatsApp Business number to move job cards + update stock.
# Built on Meta's WhatsApp Cloud API. ALL of this is off until BOT_ENABLED=true
# AND the config below is set; the webhook just 200s Meta otherwise. Setup +
# go-live steps: docs/superpowers/specs/2026-06-28-inventory-82-phase3-whatsapp.md
#   1. Meta Business → WhatsApp → add the business number → get the Phone Number ID.
#   2. Webhook callback URL = https://quote.yulelovelights.com/api/integrations/whatsapp/webhook
#      Verify token = WHATSAPP_VERIFY_TOKEN below (you choose it). Subscribe to "messages".
#   3. App secret (Meta app → Settings → Basic) → WHATSAPP_APP_SECRET (signs every webhook).
#   4. A long-lived access token → WHATSAPP_ACCESS_TOKEN.
#   5. Allowlist your staff numbers, then flip WHATSAPP_BOT_ENABLED=true.
WHATSAPP_BOT_ENABLED=false
WHATSAPP_VERIFY_TOKEN=...          # any random string; must match the Meta webhook config (openssl rand -hex 16)
WHATSAPP_APP_SECRET=...            # Meta app secret — verifies the X-Hub-Signature-256 on each webhook
WHATSAPP_ACCESS_TOKEN=...          # Cloud API bearer token for sending replies
WHATSAPP_PHONE_NUMBER_ID=...       # the business number's Phone Number ID (NOT the phone number)
WHATSAPP_ALLOWED_NUMBERS=...       # comma-separated E.164 staff numbers allowed to command the bot, e.g. +16315170186,+1...
