# Copy to .env.local and fill in real values. .env.local is gitignored.

# === Anthropic Claude (vision + quote analysis) ===
ANTHROPIC_API_KEY=sk-ant-...

# === Google Gemini (render engine — Nano Banana) ===
# Requires a Google Cloud project with billing attached.
# Pro (gemini-3-pro-image-preview): ~$0.20/call, no free tier, photoreal.
# Flash (gemini-2.5-flash-image): ~$0.04/call, has free daily quota, draft quality.
GEMINI_API_KEY=AIza...
# Default model for renders. 'pro' | 'flash'. Per-render toggle on the
# /admin/renders/new page overrides this. Default: pro.
RENDER_MODEL=pro

# === Google Maps / Street View / Satellite (address analysis) ===
GOOGLE_MAPS_API_KEY=AIza...

# === Supabase (quotes, corrections, training, renders) ===
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Service-role key bypasses RLS. Required for render pipeline writes
# because the SELECT policy restricts anon to status='approved' rows
# and the pipeline must read/write pending/rendering/ready rows.
# Server-side ONLY — never expose to the browser.
# Get it from Supabase dashboard → Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Replicate (inpainting pass for bush mini-lights) ===
# Optional. When set, the render pipeline adds a second-stage inpaint pass
# that repaints ONLY the bush/tree/column regions of the Gemini output with
# warm-white mini-lights. Sidesteps Gemini's net-light/garland prior.
# Unset = single-stage Gemini render (bush lights may look like net-lights).
# Get token: https://replicate.com/account/api-tokens  (~$0.03–0.05/render)
REPLICATE_API_TOKEN=r8_...
# Optional override. Default: zsxkib/flux-dev-inpainting (best prior for
# "christmas lights on foliage"). Use 'stability-ai/sdxl-inpainting' for a
# cheaper/faster alternative if FLUX latency hurts.
# REPLICATE_INPAINT_MODEL=zsxkib/flux-dev-inpainting

# === Render engine guardrails ===
# Monthly cap on Gemini image spend. Orchestrator refuses renders once MTD
# spend hits this. Set to a small number ($5–10) while iterating.
RENDER_BUDGET_MONTHLY_USD=10

# Shared secret required for admin mutations (approve/reject/delete).
# Pick a long random string. Admin UI prompts for it once per session.
ADMIN_SECRET=change-me-to-something-long-and-random

# === HighLevel / GoHighLevel (CRM) ===
# Private Integration token scoped to the Yule Love Lights location. Create
# at https://app.gohighlevel.com → Settings → Private Integrations → New.
# The quote tool uses this for: contact search, contact fetch, opportunity
# create/update. If unset, the admin UI falls back to manual customer entry.
HIGHLEVEL_API_KEY=pit-...
# Location ID — found in Settings → Company → Business Info, or at the end
# of the URL when viewing a sub-account.
HIGHLEVEL_LOCATION_ID=...
# Pipeline + stage IDs for the Holiday Lights sales pipeline. Discover once
# by calling listPipelines() from src/lib/integrations/highlevel.ts (there's
# a dev script at scripts/list-highlevel-pipelines.ts — see comments there).
HIGHLEVEL_PIPELINE_ID=...
HIGHLEVEL_STAGE_QUOTE_CREATED=...     # stage when a new quote is built in this tool
HIGHLEVEL_STAGE_QUOTE_SENT=...        # stage when quote is sent to customer for sign/pay
HIGHLEVEL_STAGE_QUOTE_SIGNED=...      # stage when home.works reports signature (future webhook)

# === Home.works (field service) — via Zapier ===
# home.works doesn't expose a direct API for our use case, so we route
# quote-send events through a Zapier Catch Hook. Zap setup:
#   1. Create a new Zap with trigger "Webhooks by Zapier → Catch Hook"
#   2. Copy the Catch Hook URL here
#   3. Add an action: home.works "Create Estimate" — map fields from the
#      payload (see HomeworksPayload type in src/lib/integrations/types.ts)
#   4. Turn the Zap on
# If unset, the "Send to Home.works" button is hidden in the admin UI.
HOMEWORKS_ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/.../...
