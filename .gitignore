# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local tooling (launch config, session settings) — but DO track shared project skills + commands
.claude/*
!.claude/skills/
!.claude/commands/
!.claude/agents/
# ...and shared project-scope settings (permission allow-rules the whole team gets)
!.claude/settings.json

# generated Codex mirror of .claude/skills + commands (auto-created per session,
# same content with Claude->Codex wording swapped). Generated output, never edit
# by hand — fix the source in .claude/skills/ instead.
.agents/

# graphify knowledge-graph output (generated, local)
graphify-out/

# legacy Jobber migration working data (PII: manifest, photos, state) — never commit
scripts/legacy-migration-data/

# python bytecode from the video skill's transcript scripts
__pycache__/
*.pyc

# video transcripts (third-party content; the skill writes these to a scratchpad)
video-transcripts/

# per-worktree session marker written by scripts/session-open.sh, local only
.session-id

# backfill script output — real customer addresses (PII), local only
scripts/backfill-output/

# Recovery artifacts from scripts/import-timesheet.ts (ledger row 507). These
# hold real payroll rows that were deleted, so they must never be committed:
# they are a recovery copy for a person, not source.
timesheet-import-deleted-shifts.json
timesheet*.json
